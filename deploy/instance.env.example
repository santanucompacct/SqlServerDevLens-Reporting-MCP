DEVLENS_STATE=/var/lib/devlens-reporting/example/instance.json
DEVLENS_PORT=8101
DEVLENS_ADMIN_TOKEN=replace-with-a-random-token-at-least-32-characters
DEVLENS_SQL_PASSWORD=replace-through-protected-environment-configuration
DEVLENS_ALLOWED_HOSTS=reports.example.com,reports.example.com:443,127.0.0.1,127.0.0.1:*,localhost,localhost:*

# Enable OAuth for ChatGPT web/cloud clients. Use the exact public HTTPS origin.
# Leave unset to retain bearer-only mode. Each instance needs its own issuer/state.
# DEVLENS_OAUTH_ISSUER=https://reports.example.com
# Exact trusted callback hostnames, comma-separated. Defaults shown below.
# DEVLENS_OAUTH_REDIRECT_HOSTS=chatgpt.com,chat.openai.com,oauth-redirect.googleusercontent.com
# Localhost HTTP callbacks are disabled in production. Enable only if you explicitly
# need a trusted local OAuth client: DEVLENS_OAUTH_ALLOW_LOOPBACK=1
